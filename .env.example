# Copy to .env. Secrets live here and ONLY here -- never in code.
DFS_DATABASE_URL=postgresql+psycopg2://dfs:dfs@localhost:5432/dfs
DFS_REDIS_URL=redis://localhost:6379/0
DFS_JOB_MODE=thread            # thread (dev, no redis) | rq
DFS_BLOB_DIR=./blobs
DFS_SESSION_SECRET=change-me-to-a-long-random-string
DFS_ODDS_API_KEY=              # rotate the leaked key first, then paste the NEW one
DFS_FANTASYPROS_API_KEY=
DFS_N_SIMS=50000
DFS_ENV=dev

# First-boot only: creates the initial account, then DELETE these two vars.
DFS_BOOTSTRAP_USER=
DFS_BOOTSTRAP_PASSWORD=
